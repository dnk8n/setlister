# Copy to .env (gitignored) OR, better, run `setlister config` to store keys in your OS keychain.
# Every key is optional; `setlister doctor` tells you what each one unlocks.
SETLISTER_ACOUSTID_KEY=
SETLISTER_DISCOGS_TOKEN=
# Only needed if you point notes.model at a paid provider, e.g. anthropic/claude-sonnet-5-5
SETLISTER_ANTHROPIC_API_KEY=
